{
    "pi1": {
        "name": "Raspberry Pi 1",
        "devices": {            
            "DS1": {
                "type": "button",
                "name": "Door Sensor 1",
                "simulated": true,
                "pin": 17,
                "pull_up": false,
                "bounce_time": 100
            },
            "DUS1": {
                "type": "ultrasonic",
                "name": "Ultrasonic Sensor 1",
                "pins": [23, 24],
                "simulated": true,
                "max_iter": 100
            },
            "DL": {
                "type": "diode",
                "name": "Door Light",
                "simulated": true,
                "pin": 18,
                "state": "onoff"
            },
            "DB": {
                "type": "buzzer",
                "name": "Door Buzzer",
                "simulated": true,
                "state": "onoff"
            },
            "DPIR1": {
                "type": "pir",
                "name": "Door Motion Sensor 1",
                "simulated": true,
                "pin": 4
            },
            "DMS": {
                "type": "membrane_switch",
                "name": "Door Membrane Switch",
                "row_pins": [25, 8, 7, 1],
                "col_pins": [12, 16, 20, 21],
                "simulated": true
            }           
        }
    },
    "pi2": {
        "name": "Raspberry Pi 2",
        "devices": {            
            "GSG": {
                "type": "gyro",
                "name": "Gyroscope",
                "simulated": true
            }
        }
    },
    "pi3": {
        "name": "Raspberry Pi 3",
        "devices": {
            "BRGB": {
                "type": "rgb_diode",
                "name": "Bedroom Diode",
                "red_pin": 12,
                "green_pin": 13,
                "blue_pin": 19,
                "simulated": true,
                "state": "rgb"
            }
        }
     } 
}