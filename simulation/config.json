{
    "pi1": {
        "name": "Raspberry Pi 1",
        "devices": {            
            "DS1": {
                "type": "button",
                "name": "Door Sensor 1",
                "simulated": true,
                "pin": 17,
                "pull_up": false,
                "bounce_time": 100
            },
            "DUS1": {
                "type": "ultrasonic",
                "name": "Ultrasonic Sensor 1",
                "pins": [23, 24],
                "simulated": true,
                "max_iter": 100
            },
            "DL": {
                "type": "diode",
                "name": "Door Light",
                "simulated": true,
                "pin": 18,
                "state": "onoff"
            },
            "DB": {
                "type": "buzzer",
                "name": "Door Buzzer",
                "simulated": true,
                "is_active": true,
                "pitch": 1000,
                "alternate_pitch": 1500,
                "pulse_duration": 0.3,
                "pause_duration": 0.1,
                "duty_cycle": 50,
                "pin": 27,
                "state": "onoff"
            },
            "DPIR1": {
                "type": "pir",
                "name": "Door Motion Sensor 1",
                "simulated": true,
                "pin": 4
            },
            "DMS": {
                "type": "membrane_switch",
                "name": "Door Membrane Switch",
                "row_pins": [25, 8, 7, 1],
                "col_pins": [12, 16, 20, 21],
                "simulated": true
            }           
        }
    },
    "pi2": {
        "name": "Raspberry Pi 2",
        "devices": {  
            "DHT3": {
                "type": "dht",
                "name": "Kitchen DHT",
                "simulated": true,
                "pin": 26
            },
            "DUS2": {
                "type": "ultrasonic",
                "name": "Ultrasonic Sensor 2",
                "pins": [5, 9],
                "simulated": true,
                "max_iter": 100
            },
            "BTN": {
                "type": "button",
                "name": "Kitchen Button",
                "simulated": true,
                "pin": 6,
                "pull_up": false,
                "bounce_time": 100
            },
            "GSG": {
                "type": "gyro",
                "name": "Gyroscope",
                "simulated": true
            },
            "DPIR2": {
                "type": "pir",
                "name": "Door Motion Sensor 2",
                "simulated": true,
                "pin": 4
            },
            "4SD": {
                "type": "7_segment_display",
                "name": "Kitchen 4 Digit 7 Segment Display Timer",
                "simulated": true,
                "segments": [11, 23, 8, 7, 10, 18, 25, 14],
                "digits": [22, 27, 24, 15],
                "refresh_interval": 0.001,
                "colon_pin": 16,
                "num_digits": 4
            }
        }
    },
    "pi3": {
        "name": "Raspberry Pi 3",
        "devices": {  
            "DHT1": {
                "type": "dht",
                "name": "Bedroom DHT",
                "pin": 17,
                "simulated": true
            },
            "DHT2": {
                "type": "dht",
                "name": "Master Bedroom DHT",
                "pin": 18,
                "simulated": true
            },
            "IR": {
                "type": "ir",
                "name": "Bedroom infrared",
                "simulated": true,
                "delay": 2.0,
                "pin": 16
            },
            "BRGB": {
                "type": "rgb_diode",
                "name": "Bedroom Diode",
                "red_pin": 12,
                "green_pin": 13,
                "blue_pin": 19,
                "simulated": true,
                "state": "rgb"
            },
            "LCD": {
                "type": "lcd",
                "name": "Living room Display",
                "state": "display",
                "simulated": true,
                "i2c_address": 39,
                "fallback_address": 63,
                "columns": 16,
                "rows": 2,
                "backlight_pin": 3,
                "backlight_enabled": true,
                "refresh_interval": 3
            },
            "DPIR3": {
                "type": "pir",
                "name": "Living Room Motion Sensor",
                "simulated": true,
                "pin": 4
            }
        }
     } 
}